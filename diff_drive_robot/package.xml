<?xml version="1.0"?>
<package format="3">
  <name>diff_drive_robot</name>
  <version>0.0.0</version>
  <description>Diff drive robot with STM32 + SLAM</description>

  <maintainer email="a@gmail.com">12</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Core -->
  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>

  <!-- TF -->
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>  <!-- 🔥 THÊM DÒNG NÀY -->

  <!-- Optional (Gazebo - nếu KHÔNG dùng thì nên xóa) -->
  <depend>ros_gz_bridge</depend>
  <depend>ros_gz_image</depend>
  <depend>ros_gz_sim</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>